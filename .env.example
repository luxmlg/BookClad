# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/covergen"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# OAuth providers (optional for dev, required for production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
AUTH_AMAZON_ID=""
AUTH_AMAZON_SECRET=""

# OpenAI
OPENAI_API_KEY=""

# Replicate (image upscaling)
REPLICATE_API_TOKEN=""

# Ideogram (image inpainting — if absent, falls back to OpenAI soft-mask)
IDEOGRAM_API_KEY=""

# Gemini (Google AI Studio)
GEMINI_API_KEY=""

# WebSocket (worker progress endpoint — defaults to ws://localhost:4000/ws/progress)
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws/progress"

# DodoPayments
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PRODUCT_ID_STARTER=""
DODO_PRODUCT_ID_PRO=""
DODO_PRODUCT_ID_CREDITS_50=""
DODO_PRODUCT_ID_CREDITS_100=""
DODO_PRODUCT_ID_CREDITS_250=""

# App URL (used for checkout return URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 / S3 storage
R2_ENDPOINT=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
